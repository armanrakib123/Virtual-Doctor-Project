# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=5000

APP_NAME=VirtualDoctor

API_VERSION=v1

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Production Example
# FRONTEND_URL=https://virtualdoctor.com
# ADMIN_URL=https://admin.virtualdoctor.com


# ==========================================
# DATABASE - MONGODB
# ==========================================

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/virtual_doctor?retryWrites=true&w=majority


# ==========================================
# JWT AUTHENTICATION
# ==========================================

JWT_ACCESS_SECRET=your_super_secret_access_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ==========================================
# COOKIE
# ==========================================

COOKIE_SECRET=your_cookie_secret

COOKIE_SECURE=false

COOKIE_SAME_SITE=lax


# ==========================================
# REDIS
# ==========================================

REDIS_HOST=localhost

REDIS_PORT=6379

REDIS_PASSWORD=

# Alternative URL
# REDIS_URL=redis://localhost:6379


# ==========================================
# EMAIL / SMTP
# ==========================================

SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=your_email@gmail.com

SMTP_PASSWORD=your_app_password

EMAIL_FROM="Virtual Doctor <your_email@gmail.com>"


# ==========================================
# GOOGLE OAUTH
# ==========================================

GOOGLE_CLIENT_ID=your_google_client_id

GOOGLE_CLIENT_SECRET=your_google_client_secret

GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback


# ==========================================
# SOCKET.IO
# ==========================================

SOCKET_CORS_ORIGIN=http://localhost:3000


# ==========================================
# WEBRTC / TURN SERVER
# ==========================================

TURN_SERVER_URL=turn:your-turn-server.com:3478

TURN_USERNAME=your_turn_username

TURN_PASSWORD=your_turn_password


# ==========================================
# CLOUDINARY
# ==========================================

CLOUDINARY_CLOUD_NAME=your_cloud_name

CLOUDINARY_API_KEY=your_api_key

CLOUDINARY_API_SECRET=your_api_secret


# ==========================================
# AWS S3
# ==========================================

AWS_ACCESS_KEY_ID=your_access_key

AWS_SECRET_ACCESS_KEY=your_secret_key

AWS_REGION=ap-southeast-1

AWS_S3_BUCKET=virtual-doctor-medical-files


# ==========================================
# PAYMENT
# ==========================================

PAYMENT_PROVIDER=stripe

STRIPE_SECRET_KEY=your_stripe_secret_key

STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret


# ==========================================
# BKASH
# ==========================================

BKASH_BASE_URL=https://checkout.sandbox.bka.sh

BKASH_APP_KEY=your_bkash_app_key

BKASH_APP_SECRET=your_bkash_app_secret

BKASH_USERNAME=your_bkash_username

BKASH_PASSWORD=your_bkash_password


# ==========================================
# SSLCOMMERZ
# ==========================================

SSLCOMMERZ_STORE_ID=your_store_id

SSLCOMMERZ_STORE_PASSWORD=your_store_password

SSLCOMMERZ_SANDBOX=true


# ==========================================
# SMS
# ==========================================

SMS_PROVIDER=twilio

TWILIO_ACCOUNT_SID=your_twilio_account_sid

TWILIO_AUTH_TOKEN=your_twilio_auth_token

TWILIO_PHONE_NUMBER=your_twilio_phone_number


# ==========================================
# PUSH NOTIFICATION
# ==========================================

FIREBASE_PROJECT_ID=your_project_id

FIREBASE_CLIENT_EMAIL=your_service_account_email

FIREBASE_PRIVATE_KEY="your_private_key"


# ==========================================
# VIDEO CONSULTATION
# ==========================================

VIDEO_PROVIDER=webrtc

# Twilio Alternative
TWILIO_VIDEO_API_KEY=your_api_key

TWILIO_VIDEO_API_SECRET=your_api_secret

TWILIO_VIDEO_ACCOUNT_SID=your_account_sid


# ==========================================
# AI
# ==========================================

AI_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key

GEMINI_API_KEY=your_gemini_api_key


# ==========================================
# SEARCH
# ==========================================

ELASTICSEARCH_NODE=http://localhost:9200

ELASTICSEARCH_USERNAME=elastic

ELASTICSEARCH_PASSWORD=your_password


# ==========================================
# ERROR TRACKING
# ==========================================

SENTRY_DSN=your_sentry_dsn


# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=info


# ==========================================
# RATE LIMIT
# ==========================================

RATE_LIMIT_WINDOW_MS=900000

RATE_LIMIT_MAX_REQUESTS=100


# ==========================================
# SECURITY
# ==========================================

BCRYPT_SALT_ROUNDS=12

ENCRYPTION_KEY=your_32_byte_encryption_key

CSRF_SECRET=your_csrf_secret


# ==========================================
# FILE UPLOAD
# ==========================================

MAX_FILE_SIZE=10485760

ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf


# ==========================================
# QUEUE / BULLMQ
# ==========================================

QUEUE_REDIS_HOST=localhost

QUEUE_REDIS_PORT=6379

QUEUE_REDIS_PASSWORD=


# ==========================================
# ADMIN
# ==========================================

SUPER_ADMIN_EMAIL=admin@example.com


# ==========================================
# ANALYTICS
# ==========================================

ANALYTICS_ENABLED=true


# ==========================================
# FEATURE FLAGS
# ==========================================

ENABLE_AI=true

ENABLE_VIDEO_CALL=true

ENABLE_PAYMENT=true

ENABLE_CHAT=true

ENABLE_SMS=false